{
  "manifest_version": 3,
  "name": "Шахматные пометки",
  "version": "1.1.0",
  "description": "Шахматные пометки и до трёх лучших ходов Stockfish на страницах анализа Chess.com и Lichess.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "offscreen"],
  "background": {
    "service_worker": "engine-background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Шахматные пометки",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
